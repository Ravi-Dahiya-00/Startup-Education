# Frontend Environment Variables

# LocationIQ API Key for location autocomplete
VITE_LOCATIONIQ_API_KEY=

# Backend API URL - UPDATE THIS AFTER DEPLOYING BACKEND
# Local development:
# VITE_API_URL=http://localhost:5000

# Production (Vercel):
# Replace with your actual backend URL after deploying server to Vercel
VITE_API_URL=https://your-backend-url.vercel.app

# Google OAuth Client ID (Frontend)
# Add your Google OAuth client ID here
# VITE_GOOGLE_CLIENT_ID=
